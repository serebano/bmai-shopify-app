{%- comment -%}
  Busymate AI assistant — app-embed block.
  Mounts the Busymate AI widget on every storefront page. Passes the shop domain +
  whether a customer is logged in (for identified launch). No theme edit required;
  the merchant enables it in Theme editor → App embeds (the app's Home page deep-links
  there with this embed pre-activated).

  i18n: the launcher label, its accessible name and title come from locales/*.json
  (14 Tier-1 locales) through the `t` filter; the Theme-editor strings from
  locales/*.schema.json through `t:` keys. A merchant may override the visible label
  per store in the editor.

  The serving origin and the assistant slug are NOT merchant settings: the slug is
  derived from the shop's permanent domain (== the tenant slug the app provisions)
  and the origin is the Busymate AI platform.
{%- endcomment -%}

{%- assign asst_shop_handle = shop.permanent_domain | split: '.' | first -%}
{%- assign asst_slug = 'shop-' | append: asst_shop_handle -%}
{%- assign asst_default_label = 'launcher_label' | t -%}
{%- assign asst_label = block.settings.launcher_label | default: asst_default_label -%}
{%- assign asst_aria_label = 'launcher_aria_label' | t -%}
{%- assign asst_title = 'launcher_title' | t -%}

<script
  src="{{ 'assistant.js' | asset_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-slug="{{ asst_slug }}"
  data-origin="https://busymate.ai"
  data-label="{{ asst_label | escape }}"
  data-aria-label="{{ asst_aria_label | escape }}"
  data-title="{{ asst_title | escape }}"
  data-locale="{{ request.locale.iso_code }}"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  defer></script>

{% schema %}
{
  "name": "t:name",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "launcher_label",
      "label": "t:settings.launcher_label.label",
      "info": "t:settings.launcher_label.info"
    }
  ]
}
{% endschema %}
